      "translation": [0, 0, 0],
      "scale": 0.3
    }
  },
  "animations": {
    "propellers_spin": {
      "loop": true,
      "bones": {
        "Propeller1Left": { "rotation": [0, 0, {"pre": "time * 720"}] },
        "Propeller2Left": { "rotation": [0, 0, {"pre": "time * 720"}] },
        "Propeller1Right": { "rotation": [0, 0, {"pre": "time * 720"}] },
        "Propeller2Right": { "rotation": [0, 0, {"pre": "time * 720"}] }
      }
    },
    "bomb_bay_open": {
      "loop": false,
      "bones": {
        "BombBayDoorLeft": { "rotation": [0, 0, {"pre": "query.bomb_bay_angle * -90"}] },
        "BombBayDoorRight": { "rotation": [0, 0, {"pre": "query.bomb_bay_angle * 90"}] }
      }
    },
    "control_surfaces": {
      "loop": true,
      "bones": {
        "Rudder": { "rotation": [0, {"pre": "query.yaw * 30"}, 0] },
        "ElevatorLeft": { "rotation": [{"pre": "query.pitch * 20"}, 0, 0] },
        "ElevatorRight": { "rotation": [{"pre": "query.pitch * 20"}, 0, 0] },
        "AileronLeft": { "rotation": [{"pre": "query.roll * 25"}, 0, 0] },
        "AileronRight": { "rotation": [{"pre": "query.roll * -25"}, 0, 0] }
      }
    },
    "landing_gear_retract": {
      "loop": false,
      "bones": {
        "NoseGear": { "rotation": [{"pre": "query.gear_angle * -90"}, 0, 0] },
        "MainGearLeft": { "rotation": [{"pre": "query.gear_angle * -90"}, 0, 0] },
        "MainGearRight": { "rotation": [{"pre": "query.gear_angle * -90"}, 0, 0] }
      }
    }
  }
}